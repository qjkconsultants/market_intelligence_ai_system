            "definition": "{\n  \"StartAt\": \"MarkProcessing\",\n  \"States\": {\n    \"MarkProcessing\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:states:::dynamodb:updateItem\",\n      \"Parameters\": {\n        \"TableName\": \"DocumentIngestion\",\n        \"Key\": {\n          \"PK\": { \"S.$\": \"States.Format('TENANT#{}', $.tenant_id)\" },\n          \"SK\": { \"S.$\": \"States.Format('UPLOAD#{}', $.upload_id)\" }\n        },\n        \"UpdateExpression\": \"SET #st = :p\",\n        \"ExpressionAttributeNames\": {\n          \"#st\": \"status\"\n        },\n        \"ExpressionAttributeValues\": {\n          \":p\": { \"S\": \"PROCESSING\" }\n        }\n      },\n      \"Next\": \"MockExtract\"\n    },\n\n    \"MockExtract\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:states:::lambda:invoke\",\n      \"Parameters\": {\n        \"FunctionName\": \"arn:aws:lambda:ap-southeast-2:067614922044:function:doc-ingestion-dev-mock-extract\",\n        \"Payload.$\": \"$\"\n      },\n      \"ResultSelector\": {\n        \"extraction_output_key.$\": \"$.Payload.extraction_output_key\"\n      },\n      \"ResultPath\": \"$.extraction\",\n      \"Next\": \"MarkComplete\"\n    },\n\n    \"MarkComplete\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:states:::dynamodb:updateItem\",\n      \"Parameters\": {\n        \"TableName\": \"DocumentIngestion\",\n        \"Key\": {\n          \"PK\": { \"S.$\": \"States.Format('TENANT#{}', $.tenant_id)\" },\n          \"SK\": { \"S.$\": \"States.Format('UPLOAD#{}', $.upload_id)\" }\n        },\n        \"UpdateExpression\": \"SET #st = :c, extraction_output_key = :k\",\n        \"ExpressionAttributeNames\": {\n          \"#st\": \"status\"\n        },\n        \"ExpressionAttributeValues\": {\n          \":c\": { \"S\": \"COMPLETE\" },\n          \":k\": { \"S.$\": \"$.extraction.extraction_output_key\" }\n        }\n      },\n      \"End\": true\n    }\n  }\n}\n",
